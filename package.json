{
  "name": "ayso-roster-pro",
  "version": "1.0.0",
  "description": "AYSO Roster Pro - Smart lineup generator for youth soccer teams",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server.js",
    "postinstall": "node scripts/copy-vendor.js",
    "migrate": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create --migration-file-language sql --migration-filename-format utc",
    "build:icons": "node scripts/build-icons.js",
    "build:pwa-icons": "node scripts/build-pwa-icons.js",
    "build:assets": "npm run build:icons && npm run build:pwa-icons && npm run build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:db": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.js",
    "pretest:e2e": "playwright install chromium && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run test && npm run test:db && npm run test:e2e"
  },
  "engines": {
    "node": "^20.9.0 || >=22.0.0"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "connect-pg-simple": "^10.0.0",
    "csrf-sync": "^4.2.1",
    "express": "^4.22.1",
    "express-rate-limit": "^8.3.1",
    "express-session": "^1.19.0",
    "lucide-react": "^1.33.0",
    "node-pg-migrate": "^9.0.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.121",
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "^2.6.2",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "jest": "^29.7.0",
    "postcss": "^8.5.26",
    "railway": "^3.11.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^6.4.3"
  },
  "keywords": [
    "soccer",
    "lineup",
    "ayso",
    "sports",
    "team-management"
  ],
  "author": "",
  "license": "MIT",
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/e2e/",
      "/tests/integration/"
    ],
    "transform": {},
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "js",
      "mjs"
    ]
  }
}
