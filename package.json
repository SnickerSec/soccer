{
  "name": "ayso-roster-pro",
  "version": "1.0.0",
  "description": "AYSO Roster Pro - Smart lineup generator for youth soccer teams",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "postinstall": "node scripts/copy-vendor.js",
    "migrate": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create --migration-file-language sql --migration-filename-format utc",
    "build:icons": "node scripts/build-icons.js",
    "build:pwa-icons": "node scripts/build-pwa-icons.js",
    "build:assets": "npm run build:icons && npm run build:pwa-icons",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:db": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.js",
    "pretest:e2e": "playwright install chromium",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run test && npm run test:db && npm run test:e2e"
  },
  "engines": {
    "node": "^20.9.0 || >=22.0.0"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "connect-pg-simple": "^10.0.0",
    "csrf-sync": "^4.2.1",
    "express": "^4.22.1",
    "express-rate-limit": "^8.3.1",
    "express-session": "^1.19.0",
    "node-pg-migrate": "^9.0.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.18.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.121",
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "^2.6.2",
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  },
  "keywords": [
    "soccer",
    "lineup",
    "ayso",
    "sports",
    "team-management"
  ],
  "author": "",
  "license": "MIT",
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/e2e/",
      "/tests/integration/"
    ],
    "transform": {},
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "js",
      "mjs"
    ]
  }
}
